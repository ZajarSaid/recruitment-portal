# ------------------------------------------------------------------
# Recruitment Portal - environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ------------------------------------------------------------------

# MySQL connection string.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:your_password@localhost:3306/recruitment_portal"

# Secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="replace_with_a_long_random_secret_at_least_32_characters"

# Node environment (development | production | test)
NODE_ENV="development"

# Public base URL of the app (used for links such as password reset).
APP_URL="http://localhost:3000"

# Controls the `secure` flag on session cookies. Set to "true" in production.
SESSION_COOKIE_SECURE="false"

# ------------------------------------------------------------------
# Application document uploads
# ------------------------------------------------------------------

# When Cloudinary credentials (below) are configured, uploaded application
# documents and profile photographs are stored in Cloudinary. The settings here
# then only govern validation (size/type) and the local fallback used when
# Cloudinary is not configured.

# Directory for locally stored uploaded documents (cloud fallback only). Must be
# outside `public/`. Defaults to `<project>/storage` when unset.
UPLOAD_DIR="storage"

# Maximum size (bytes) for a single uploaded file. Defaults to 5242880 (5 MB).
# If raised, also raise `experimental.serverActions.bodySizeLimit` in next.config.ts.
UPLOAD_MAX_FILE_SIZE_BYTES="5242880"

# Comma-separated MIME allow-list. Defaults to application/pdf,image/jpeg,image/png.
UPLOAD_ALLOWED_MIME_TYPES="application/pdf,image/jpeg,image/png"

# ------------------------------------------------------------------
# Cloudinary (cloud file storage & image delivery)
# ------------------------------------------------------------------

# Cloud name from the Cloudinary console dashboard. Public by design —
# required by `next-cloudinary` (CldImage) on the client.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"

# API key (exposed to the browser) and API secret (server-only, never expose).
NEXT_PUBLIC_CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
