{
  "name": "recruitment-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:setup": "tsx scripts/setup-test-db.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:test": "tsx scripts/test-database.ts",
    "email": "email dev --dir src/emails"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.0",
    "@react-email/components": "^1.0.12",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.8",
    "jose": "^6.2.12",
    "next": "16.4.1",
    "next-cloudinary": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "^6.11.3",
    "resend": "^6.35.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-email/ui": "^6.11.3",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "jsdom": "^30.1.3",
    "mariadb": "^3.5.4",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
