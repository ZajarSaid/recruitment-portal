// Recruitment Portal schema (Prisma ORM 7 / MySQL)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
}

enum JobCategory {
  GENERAL
  MEDICINE
  IT
  BUSINESS
}

enum EducationLevel {
  NONE
  PRIMARY
  SECONDARY
  CERTIFICATE
  DIPLOMA
  BACHELOR
  MASTER
  DOCTORATE
}

enum ComputerLiteracyLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
}

enum DocumentReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CANDIDATE)
  isActive     Boolean  @default(true)
  activationTokenHash String? @unique @db.Char(64)
  activationExpiresAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdJobs         Job[]                      @relation("JobCreator")
  assignedJobs        Job[]                      @relation("JobRecruiter")
  applications        Application[]
  statusChanges       ApplicationStatusHistory[]
  evaluations         ApplicationEvaluation[]
  reviewedDocuments   ApplicationDocument[]      @relation("DocumentReviewer")
  stagedDocuments     StagedDocument[]
  passwordResetTokens PasswordResetToken[]
  adminSignInChallenge AdminSignInChallenge?
  sessions            UserSession[]
  profile             CandidateProfile?

  @@index([role])
  @@index([isActive])
}

// The candidate's once-only master record: personal details, education,
// address, computer literacy, languages and the category-specific documents.
// Completed once after registering, it is reused for every future vacancy
// application, so applying only requires the signed application letter.
model CandidateProfile {
  id               String                 @id @default(cuid())
  userId           String                 @unique
  educationLevel   EducationLevel?
  // Birth date as independent year and month values (the day is not asked).
  birthYear        Int?
  birthMonth       Int?
  physicalAddress  String?                @db.VarChar(500)
  nidaNumber       String?                @db.VarChar(20)
  phone            String?                @db.VarChar(40)
  location         String?                @db.VarChar(160)
  headline         String?                @db.VarChar(160)
  computerLiteracy ComputerLiteracyLevel?
  // Comma-separated list of languages the candidate speaks.
  languages        String?                @db.VarChar(500)
  experienceSummary String?               @db.Text
  // The professional field the candidate categorises themselves in. Drives
  // which category-specific documents are requested on the profile.
  category         JobCategory            @default(GENERAL)
  // Passport-style photograph, stored in cloud storage (public URL).
  photoUrl         String?                @db.VarChar(512)
  photoPublicId    String?                @db.VarChar(255)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents CandidateDocument[]
  education CandidateEducation[]
  employment CandidateEmployment[]
  skills CandidateSkill[]
  certifications CandidateCertification[]

  @@index([category])
}

model CandidateEducation {
  id            String @id @default(cuid())
  profileId     String
  qualification String @db.VarChar(160)
  institution   String @db.VarChar(160)
  fieldOfStudy  String? @db.VarChar(160)
  startDate     DateTime? @db.Date
  endDate       DateTime? @db.Date
  grade         String? @db.VarChar(40)
  profile       CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, startDate])
}

model CandidateEmployment {
  id           String @id @default(cuid())
  profileId    String
  jobTitle     String @db.VarChar(160)
  organization String @db.VarChar(160)
  startDate    DateTime @db.Date
  endDate      DateTime? @db.Date
  current      Boolean @default(false)
  description  String? @db.Text
  profile      CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, startDate])
}

model CandidateSkill {
  id        String @id @default(cuid())
  profileId String
  name      String @db.VarChar(80)
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
}

model CandidateCertification {
  id                 String @id @default(cuid())
  profileId          String
  name               String @db.VarChar(160)
  issuer             String @db.VarChar(160)
  registrationNumber String? @db.VarChar(120)
  issueDate          DateTime? @db.Date
  expiryDate         DateTime? @db.Date
  profile            CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, issueDate])
}

model UserSession {
  tokenHash  String   @id @db.Char(64)
  userId     String   @unique
  lastSeenAt DateTime
  expiresAt  DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AdminSignInChallenge {
  id             String   @id @db.VarChar(64)
  userId         String   @unique
  codeHash       String   @db.Char(64)
  expiresAt      DateTime
  attempts       Int      @default(0)
  accountVersion DateTime
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One uploaded file attached to the candidate's profile, keyed to a
// well-known catalog entry (see `src/lib/profile-documents.ts`). Re-uploading
// the same document key replaces the stored row.
model CandidateDocument {
  id               String   @id @default(cuid())
  profileId        String
  documentKey      String   @db.VarChar(100)
  storageKey       String   @unique @db.VarChar(255)
  // Public cloud delivery URL when the file lives in cloud storage; null for
  // files retained in local private storage.
  cloudUrl         String?  @db.VarChar(512)
  originalFileName String   @db.VarChar(255)
  mimeType         String
  fileSize         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, documentKey])
  @@index([profileId])
}

model Job {
  id             String      @id @default(cuid())
  title          String
  department     String
  location       String
  description    String      @db.Text
  qualifications String      @db.Text
  // Professional field of the vacancy. Used to surface candidates whose
  // profile category matches, and shown to candidates before they apply.
  category       JobCategory @default(GENERAL)
  opensAt        DateTime
  closesAt       DateTime
  status         JobStatus   @default(DRAFT)
  createdById    String
  recruiterId    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  createdBy      User   @relation("JobCreator", fields: [createdById], references: [id], onDelete: Restrict)
  recruiter      User?  @relation("JobRecruiter", fields: [recruiterId], references: [id], onDelete: SetNull)
  applications   Application[]
  stagedDocuments StagedDocument[]

  @@index([status, closesAt])
  @@index([createdById])
  @@index([recruiterId])
  @@index([department])
}

model Application {
  id            String            @id @default(cuid())
  candidateId   String
  jobId         String
  resumeSummary String            @db.Text
  status        ApplicationStatus @default(SUBMITTED)
  submittedAt   DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Legacy field: requirements as configured on the vacancy at submission
  // time, kept only so historical applications keep rendering correctly.
  // Modern applications always carry a single "APPLICATION_LETTER" entry.
  requirementSnapshot Json?

  // Optional profile photograph supplied by the candidate during the
  // application. Stored in cloud storage; the URL is public/readable by the
  // candidate and by recruiters who manage the vacancy.
  photoUrl       String? @db.VarChar(512)
  photoPublicId  String? @db.VarChar(255)

  candidate  User                        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job        Job                         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  evaluation ApplicationEvaluation?
  history    ApplicationStatusHistory[]
  documents  ApplicationDocument[]

  // A candidate may apply only once per job (enforced at the database level).
  @@unique([candidateId, jobId])
  @@index([jobId])
  @@index([candidateId])
  @@index([status])
}

model ApplicationEvaluation {
  id            String   @id @default(cuid())
  applicationId String   @unique
  score         Int
  method        String
  notes         String?  @db.Text
  evaluatedById                String?
  evaluatedAt                  DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  evaluatedBy User?       @relation(fields: [evaluatedById], references: [id], onDelete: SetNull)

  @@index([evaluatedById])
}

// A file uploaded by a candidate before the application is finalized. Keeping
// staged uploads in their own table guarantees that an application is only
// created once every mandatory document is present, so a partially uploaded
// application can never be mistaken for a completed one. With profile-based
// applications, the only staged document is the signed application letter.
model StagedDocument {
  id               String   @id @default(cuid())
  candidateId      String
  jobId            String
  // Well-known document key, e.g. "APPLICATION_LETTER" (see
  // `src/lib/profile-documents.ts`).
  documentKey      String   @db.VarChar(100)
  storageKey       String   @unique @db.VarChar(255)
  // When the file lives in cloud storage, this holds its public delivery URL.
  // Null for files kept in local private storage (see `storageKey`).
  cloudUrl         String?  @db.VarChar(512)
  originalFileName String   @db.VarChar(255)
  mimeType         String
  fileSize         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  candidate User @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // One staged file per document key per candidate per vacancy (replacement
  // updates the existing row).
  @@unique([candidateId, jobId, documentKey])
  @@index([candidateId, jobId])
}

model ApplicationStatusHistory {
  id            String             @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  actorId       String
  note          String?            @db.Text
  createdAt     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User        @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@index([actorId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Metadata for a file uploaded against an application. Since profile-based
// applications, the only document collected at application time is the signed
// application letter (`documentKey = "APPLICATION_LETTER"`). The binary lives
// in private storage; only its reference is persisted here. `documentKey` is
// null for legacy documents uploaded against the old per-vacancy requirements.
model ApplicationDocument {
  id               String               @id @default(cuid())
  applicationId    String
  // Well-known document key for modern uploads; null for legacy rows.
  documentKey      String?              @db.VarChar(100)
  // Legacy snapshot copy of the per-vacancy requirement id this file was
  // uploaded against. Kept so historical files keep their meaning; modern
  // uploads mirror `documentKey` here.
  requirementKey   String?              @db.VarChar(100)
  storageKey       String               @unique @db.VarChar(255)
  // Public cloud delivery URL when the file lives in cloud storage; null for
  // files retained in local private storage.
  cloudUrl         String?              @db.VarChar(512)
  originalFileName String               @db.VarChar(255)
  mimeType         String
  fileSize         Int
  reviewStatus     DocumentReviewStatus @default(PENDING)
  reviewComment    String?              @db.Text
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewedBy  User?       @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([documentKey])
  @@index([reviewedById])
  @@index([reviewStatus])
}
